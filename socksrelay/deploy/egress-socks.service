[Unit]
Description=socksrelay: authenticated SOCKS5 relay for egress split mode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=egress-socks
Group=egress-socks
ExecStart=/usr/local/bin/socksrelay --listen=127.0.0.1:7109 --auth-file=/etc/egress-socks/auth --limit-mbps=20 --limit-mbps-per-user=5 --owner-user=egress-owner --owner-mbps=20 --usage-file=/var/lib/egress-socks/usage.json
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes

[Install]
WantedBy=multi-user.target
