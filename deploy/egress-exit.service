[Unit]
Description=Learn which destination prefixes need the residential exit
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
ExecStart=/usr/local/bin/egress-exit
Restart=always
RestartSec=30
StateDirectory=egress-exit

[Install]
WantedBy=multi-user.target
