[Unit]
Description=egress enrollment agent: binds first-activation keys
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
ExecStart=/usr/local/bin/egress-enroll-agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
