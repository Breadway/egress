[Unit]
Description=Provision approved bypass enrollment applications
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=breadway
Group=breadway
Environment=HOME=/home/breadway
# Version embedded in provisioned device builds.
Environment=EGRESS_VERSION=0.4.21
WorkingDirectory=/home/breadway/Projects/Apps/egress
ExecStart=/home/breadway/Projects/Apps/egress/provision-pending.py
Restart=always
RestartSec=10
ProtectSystem=full
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
